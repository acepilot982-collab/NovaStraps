<Window x:Class="NovaStrap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NovaStrap" Height="780" Width="1200" MinHeight="620" MinWidth="950" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#10131A" BorderBrush="#202636" BorderThickness="0,0,1,0"><DockPanel Margin="15"><StackPanel DockPanel.Dock="Top" Margin="3,8,3,24"><StackPanel Orientation="Horizontal"><Border Width="35" Height="35" CornerRadius="11" Background="{StaticResource AccentBrush}"><TextBlock Text="N" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="NOVASTRAP" FontWeight="Bold" FontSize="16"/><TextBlock Text="ROBLOX COMPANION" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel></StackPanel>
<StackPanel x:Name="Nav"><Button Content="⌂   Home" Tag="Home" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="▶   Launch" Tag="Launch" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="▦   Game Library" Tag="Game Library" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="⚙   Client Settings" Tag="Client Settings" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="⚑   FastFlags" Tag="FastFlags" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="◇   Mod Manager" Tag="Mod Manager" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="✧   Cursor Studio" Tag="Cursor Studio" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="⌁   Performance" Tag="Performance" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="◉   Discord" Tag="Discord" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="◐   Themes" Tag="Themes" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="⌕   Diagnostics" Tag="Diagnostics" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="☷   Settings" Tag="Settings" Click="Nav_Click" HorizontalContentAlignment="Left"/><Button Content="ⓘ   About" Tag="About" Click="Nav_Click" HorizontalContentAlignment="Left"/></StackPanel>
</DockPanel></Border>
<Grid Grid.Column="1" Margin="28,23,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,20"><StackPanel><TextBlock x:Name="PageTitle" Text="Welcome back." FontSize="27" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Your Roblox setup, one calm place." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#171C26" CornerRadius="15" Padding="12,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#F5B94C" Margin="0,0,8,0"/><TextBlock x:Name="TopStatus" Text="Checking Roblox…" FontSize="11" VerticalAlignment="Center"/></StackPanel></Border></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Content"/></ScrollViewer><TextBlock Grid.Row="2" Text="NOVASTRAP  •  Local-first  •  No credentials collected" FontSize="10" Foreground="#687186" Margin="0,14,0,0"/></Grid>
</Grid></Window>
